---
import '../styles/global.css';
import { canonicalUrl, defaultSocialImage, pageSchema } from '../data/seo.js';

const { title, description = 'Beastie Studio: juegos hechos con cariño.', activePath = Astro.url.pathname, image = defaultSocialImage, imageAlt = 'Logo de Beastie Studio', type = 'website', breadcrumbs = [], entity } = Astro.props;
const pathname = Astro.url.pathname;
const siteUrl = Astro.site?.origin || 'https://beastie-studio.silverman.pro';
const canonical = canonicalUrl(pathname, siteUrl);
const socialImage = new URL(image, siteUrl).href;
const structuredData = pageSchema({ siteUrl, pathname, breadcrumbs, entity });
const navigation = [
  { href: '/', label: 'Inicio' },
  { href: '/juegos', label: 'Juegos' },
  { href: '/novedades', label: 'Novedades' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/apoyanos', label: 'Apóyanos' }
];
const isActive = (href) => href === '/' ? activePath === '/' : activePath.startsWith(href);
---
<!doctype html>
<html lang="es">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Beastie Studio" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={`${title} · Beastie Studio`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Beastie Studio`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <title>{title} · Beastie Studio</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" data-sticky-header>
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Beastie Studio, ir al inicio">
          <img src="/assets/brand/beastie-logo-approved.png" alt="BEASTIE STUDIO" width="2048" height="682" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
          <span class="menu-icon" aria-hidden="true">☰</span><span class="menu-label">Menú</span>
        </button>
        <nav id="site-navigation" class="site-nav" aria-label="Navegación principal">
          <ul>
            {navigation.map((item) => <li><a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div><p class="eyebrow">Beastie Studio</p><p class="signature">Juegos hechos con cariño.</p></div>
        <div><p class="footer-note">Descubrir. Pensar. Compartir.</p><a class="footer-support" href="/apoyanos">Conoce cómo apoyar el proyecto →</a></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const navigation = document.querySelector('#site-navigation');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        navigation?.classList.toggle('is-open', !open);
      });
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        navigation?.classList.remove('is-open');
      }));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const parallaxHeroes = [...document.querySelectorAll('[data-parallax]')];
      const revealBlocks = [...document.querySelectorAll('[data-reveal]')];
      let frame = 0;
      const updateParallax = () => {
        frame = 0;
        for (const hero of parallaxHeroes) {
          const rect = hero.getBoundingClientRect();
          const progress = Math.max(0, Math.min(1, -rect.top / Math.max(1, rect.height)));
          const offset = reducedMotion.matches ? 0 : (progress - 0.5) * -180;
          hero.style.setProperty('--parallax-progress', progress.toFixed(3));
          hero.style.setProperty('--parallax-offset', `${offset.toFixed(2)}px`);
          hero.style.setProperty('--parallax-text-offset', `${(offset * -0.12).toFixed(2)}px`);
        }
      };
      const onScroll = () => { if (!frame) frame = requestAnimationFrame(updateParallax); };
      if (parallaxHeroes.length && !reducedMotion.matches) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        reducedMotion.addEventListener?.('change', updateParallax);
        updateParallax();
      }
      if (revealBlocks.length && !reducedMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-revealed'); observer.unobserve(entry.target); } }), { threshold: 0.12 });
        revealBlocks.forEach((block) => observer.observe(block));
      } else revealBlocks.forEach((block) => block.classList.add('is-revealed'));
    </script>
  </body>
</html>
<style is:global>
  :root { --ivory:#FFF8F4; --terracotta:#D3432B; --ultramarine:#2A5CDE; --green:#1F8A65; --mustard:#E59F24; --ink:#1E1B18; --line:#eadfd9; font-family:'Plus Jakarta Sans', Arial, sans-serif; color:var(--ink); background:var(--ivory); }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; min-width:320px; background:var(--ivory); } a { color:inherit; } .shell { width:min(1120px, calc(100% - 40px)); margin-inline:auto; }
  .skip-link { position:absolute; left:1rem; top:-4rem; z-index:10; padding:.75rem 1rem; background:var(--ink); color:white; } .skip-link:focus { top:1rem; }
  .site-header { position:sticky; top:0; z-index:5; border-bottom:1px solid var(--line); background:rgba(255,248,244,.95); backdrop-filter:blur(12px); } .header-inner { min-height:96px; display:flex; align-items:center; gap:2rem; } .brand { width:164px; display:block; } .brand img { display:block; width:100%; height:auto; } .site-nav { margin-left:auto; } .site-nav ul { display:flex; gap:.35rem; list-style:none; margin:0; padding:0; } .site-nav a, .menu-toggle { min-height:48px; display:inline-flex; align-items:center; justify-content:center; padding:.75rem 1rem; border-radius:999px; text-decoration:none; font-weight:600; transition:color 180ms ease, background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; } .site-nav a:hover, .site-nav a.active { color:var(--terracotta); background:#fff0ea; box-shadow:0 5px 12px rgba(30,27,24,.08); transform:translateY(-1px); } .menu-toggle { display:none; margin-left:auto; border:1px solid var(--line); background:transparent; color:var(--ink); font:inherit; gap:.4rem; }
  main { min-height:calc(100vh - 280px); } .page { padding:clamp(4rem, 10vw, 8rem) 0; } .eyebrow { margin:0 0 1rem; color:var(--terracotta); font-size:.8rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; } h1,h2,h3 { font-family:Outfit, Arial, sans-serif; line-height:1.05; } h1 { max-width:760px; margin:.2rem 0 1.5rem; font-size:clamp(3rem, 8vw, 6.5rem); letter-spacing:-.045em; } h2 { font-size:clamp(2rem,4vw,3.25rem); margin:.25rem 0 1rem; } .lead { max-width:650px; font-size:clamp(1.1rem, 2vw, 1.4rem); line-height:1.7; } .placeholder { margin-top:3rem; padding:1.5rem; border:2px dashed #d9c6bc; border-radius:1.25rem; background:#fffdfb; } .placeholder strong { color:var(--terracotta); } .site-footer { padding:3rem 0 5rem; border-top:1px solid var(--line); background:#fff0ea; } .footer-grid { display:flex; justify-content:space-between; gap:2rem; } .signature { margin:0; font:600 clamp(1.5rem,3vw,2.4rem)/1.1 Outfit, Arial, sans-serif; } .footer-note { margin-top:0; font-weight:600; } .footer-support { color:var(--terracotta); font-weight:700; } .support-cta { position:fixed; right:clamp(1rem,4vw,2rem); bottom:1rem; z-index:3; min-height:48px; display:inline-flex; align-items:center; padding:.85rem 1.2rem; border-radius:999px; background:var(--terracotta); color:#fff; box-shadow:0 8px 24px rgba(30,27,24,.18); text-decoration:none; font-weight:700; } .button-row { display:flex; flex-wrap:wrap; gap:.8rem; margin-top:2rem; } .button { min-height:48px; display:inline-flex; align-items:center; gap:.5rem; padding:.8rem 1.15rem; border-radius:999px; text-decoration:none; font-weight:700; } .button-primary { background:var(--terracotta); color:#fff; } .button-secondary { border:2px solid var(--ink); } .section-heading { max-width:650px; margin-bottom:2.5rem; } .section-heading p { line-height:1.7; } .hero { padding:clamp(5rem,12vw,10rem) 0 6rem; background:linear-gradient(135deg,#fff8f4,#ffe9df); } .hero h1 { max-width:900px; } .section { padding:clamp(4rem,8vw,7rem) 0; } .section-tint { background:#eef4ff; } .card-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.5rem; } .game-card { overflow:hidden; border:1px solid var(--line); border-radius:1.5rem; background:#fff; box-shadow:0 12px 30px rgba(30,27,24,.06); } .conceptual-art { min-height:220px; display:grid; place-items:center; padding:2rem; background:linear-gradient(135deg,#dce8ff,#f5dfbd); color:var(--ink); font:600 clamp(2rem,5vw,4rem)/1 Outfit,Arial,sans-serif; text-align:center; } .conceptual-art span { transform:rotate(-4deg); } .game-card-body { padding:2rem; } .game-card-body p:not(.eyebrow) { line-height:1.7; } .game-detail { display:grid; grid-template-columns:minmax(280px,.85fr) 1.15fr; gap:clamp(2rem,6vw,6rem); align-items:center; } .game-detail-visual { min-height:430px; border-radius:2rem; } .game-detail-copy > p:not(.eyebrow):not(.lead) { max-width:680px; line-height:1.8; } .not-available { max-width:600px; margin-top:2rem; padding:1rem 1.2rem; border-left:4px solid var(--mustard); background:#fffdf2; line-height:1.6; } :focus-visible { outline:3px solid var(--ultramarine); outline-offset:4px; }
  @media (max-width:700px) { .shell { width:min(100% - 32px, 560px); } .header-inner { min-height:76px; } .brand { width:135px; } .menu-toggle { display:inline-flex; } .site-nav { display:none; position:absolute; top:76px; left:0; right:0; z-index:2; padding:1rem; border-bottom:1px solid var(--line); background:var(--ivory); box-shadow:0 12px 24px rgba(30,27,24,.08); } .site-nav.is-open { display:block; } .site-nav ul { flex-direction:column; } .site-nav a { justify-content:flex-start; width:100%; } .page { padding:4rem 0 7rem; } h1 { font-size:clamp(2.8rem, 15vw, 5rem); } .footer-grid { flex-direction:column; } .card-grid { grid-template-columns:1fr; } .game-detail { display:flex; flex-direction:column; align-items:stretch; } .game-detail-visual { min-height:260px; } .support-cta { right:1rem; bottom:1rem; } }
  .news-index h1 { max-width:780px; } .category-filter { margin:3rem 0 4rem; padding:1.25rem; border:1px solid var(--line); border-radius:1.25rem; background:#fff; } .filter-label { display:block; margin-bottom:.75rem; font-weight:700; } .filter-controls { display:flex; flex-wrap:wrap; gap:.6rem; } .filter-button { min-height:48px; padding:.65rem 1rem; border:1px solid var(--line); border-radius:999px; background:var(--ivory); color:var(--ink); font:inherit; font-weight:700; cursor:pointer; } .filter-button:hover, .filter-button.is-selected { border-color:var(--terracotta); background:#fff0ea; color:var(--terracotta); } .filter-count { margin-left:.25rem; font-size:.8em; } .filter-status { margin:.9rem 0 0; color:#605650; } .featured-news { margin-bottom:5rem; } .news-card { border:1px solid var(--line); border-radius:1.5rem; background:#fff; box-shadow:0 12px 30px rgba(30,27,24,.06); } .news-card-body { padding:clamp(1.5rem,4vw,2.5rem); } .news-card h2 { margin-top:.2rem; } .news-card h2 a { text-decoration:none; } .news-card h2 a:hover { color:var(--terracotta); } .news-card p:not(.eyebrow) { max-width:700px; line-height:1.7; } .news-card.featured { background:linear-gradient(135deg,#fff0ea,#eef4ff); } .news-list { padding-top:1rem; } .breadcrumb { display:flex; flex-wrap:wrap; gap:.65rem; align-items:center; margin-bottom:3rem; color:#605650; font-size:.95rem; } .breadcrumb a { color:var(--terracotta); font-weight:700; } .article-shell { max-width:820px; } .article-header { margin-bottom:3rem; } .article-header h1 { max-width:800px; font-size:clamp(2.6rem,7vw,5.5rem); } .article-body { max-width:720px; font-size:1.1rem; line-height:1.85; } .article-body h2, .article-body h3 { margin-top:2.75rem; } .article-body p { margin:0 0 1.5rem; } .article-hero { display:block; width:100%; height:auto; margin:0 0 3rem; border-radius:1.5rem; } .article-actions { display:flex; flex-wrap:wrap; gap:.8rem; margin:3rem 0 5rem; } .related { border-top:1px solid var(--line); padding-top:3rem; } .support-intro { display:grid; grid-template-columns:minmax(0,1fr) minmax(220px,360px); gap:clamp(2rem,7vw,7rem); align-items:center; } .support-illustration { display:block; width:100%; height:auto; border-radius:2rem; background:#ffe9df; } .support-options { margin-top:clamp(4rem,10vw,8rem); } .support-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; } .support-card { display:flex; min-height:180px; flex-direction:column; justify-content:space-between; gap:1.5rem; padding:1.5rem; border:1px solid var(--line); border-radius:1.25rem; background:#fff; box-shadow:0 12px 30px rgba(30,27,24,.05); } .support-card h2 { margin:.35rem 0 0; font-size:clamp(1.6rem,3vw,2.25rem); } .support-card-type { margin:0; color:#605650; font-size:.9rem; font-weight:700; } .support-pending { margin:0; color:#605650; line-height:1.5; } .support-sharing { margin-top:clamp(4rem,10vw,8rem); padding:clamp(2rem,5vw,4rem); border-radius:2rem; background:#eef4ff; } .support-sharing h2 { max-width:650px; } .support-sharing p:not(.eyebrow) { max-width:650px; line-height:1.7; } .support-thanks { margin-top:4rem; font:600 clamp(1.5rem,3vw,2.4rem)/1.1 Outfit,Arial,sans-serif; }
  @media (max-width:700px) { .support-intro { grid-template-columns:1fr; } .support-illustration { max-width:320px; margin-inline:auto; } .support-grid { grid-template-columns:1fr; } }
</style>
