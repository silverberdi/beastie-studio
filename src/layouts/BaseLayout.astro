---
const { title, description = 'Beastie Studio: juegos hechos con cariño.', activePath = Astro.url.pathname } = Astro.props;
const navigation = [
  { href: '/', label: 'Inicio' },
  { href: '/juegos', label: 'Juegos' },
  { href: '/novedades', label: 'Novedades' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/apoyanos', label: 'Apóyanos' }
];
const isActive = (href) => href === '/' ? activePath === '/' : activePath.startsWith(href);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · Beastie Studio</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Beastie Studio, ir al inicio">
          <img src="/assets/brand/beastie-logo-approved.png" alt="BEASTIE STUDIO" width="2048" height="682" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
          <span class="menu-icon" aria-hidden="true">☰</span><span class="menu-label">Menú</span>
        </button>
        <nav id="site-navigation" class="site-nav" aria-label="Navegación principal">
          <ul>
            {navigation.map((item) => <li><a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenido"> <slot /> </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div><p class="eyebrow">Beastie Studio</p><p class="signature">Juegos hechos con cariño.</p></div>
        <div><p class="footer-note">Descubrir. Pensar. Compartir.</p><a class="footer-support" href="/apoyanos">Conoce cómo apoyar el proyecto →</a></div>
      </div>
    </footer>
    <a class="support-cta" href="/apoyanos">¡Apóyanos!</a>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const navigation = document.querySelector('#site-navigation');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        navigation?.classList.toggle('is-open', !open);
      });
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        navigation?.classList.remove('is-open');
      }));
    </script>
  </body>
</html>
<style is:global>
  :root { --ivory:#FFF8F4; --terracotta:#D3432B; --ultramarine:#2A5CDE; --green:#1F8A65; --mustard:#E59F24; --ink:#1E1B18; --line:#eadfd9; font-family:'Plus Jakarta Sans', Arial, sans-serif; color:var(--ink); background:var(--ivory); }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; min-width:320px; background:var(--ivory); } a { color:inherit; } .shell { width:min(1120px, calc(100% - 40px)); margin-inline:auto; }
  .skip-link { position:absolute; left:1rem; top:-4rem; z-index:10; padding:.75rem 1rem; background:var(--ink); color:white; } .skip-link:focus { top:1rem; }
  .site-header { border-bottom:1px solid var(--line); background:rgba(255,248,244,.95); } .header-inner { min-height:96px; display:flex; align-items:center; gap:2rem; } .brand { width:164px; display:block; } .brand img { display:block; width:100%; height:auto; } .site-nav { margin-left:auto; } .site-nav ul { display:flex; gap:.35rem; list-style:none; margin:0; padding:0; } .site-nav a, .menu-toggle { min-height:48px; display:inline-flex; align-items:center; justify-content:center; padding:.75rem 1rem; border-radius:999px; text-decoration:none; font-weight:600; } .site-nav a:hover, .site-nav a.active { color:var(--terracotta); background:#fff0ea; } .menu-toggle { display:none; margin-left:auto; border:1px solid var(--line); background:transparent; color:var(--ink); font:inherit; gap:.4rem; }
  main { min-height:calc(100vh - 280px); } .page { padding:clamp(4rem, 10vw, 8rem) 0; } .eyebrow { margin:0 0 1rem; color:var(--terracotta); font-size:.8rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; } h1,h2,h3 { font-family:Outfit, Arial, sans-serif; line-height:1.05; } h1 { max-width:760px; margin:.2rem 0 1.5rem; font-size:clamp(3rem, 8vw, 6.5rem); letter-spacing:-.045em; } .lead { max-width:650px; font-size:clamp(1.1rem, 2vw, 1.4rem); line-height:1.7; } .placeholder { margin-top:3rem; padding:1.5rem; border:2px dashed #d9c6bc; border-radius:1.25rem; background:#fffdfb; } .placeholder strong { color:var(--terracotta); } .site-footer { padding:3rem 0 5rem; border-top:1px solid var(--line); background:#fff0ea; } .footer-grid { display:flex; justify-content:space-between; gap:2rem; } .signature { margin:0; font:600 clamp(1.5rem,3vw,2.4rem)/1.1 Outfit, Arial, sans-serif; } .footer-note { margin-top:0; font-weight:600; } .footer-support { color:var(--terracotta); font-weight:700; } .support-cta { position:fixed; right:clamp(1rem,4vw,2rem); bottom:1rem; z-index:3; min-height:48px; display:inline-flex; align-items:center; padding:.85rem 1.2rem; border-radius:999px; background:var(--terracotta); color:#fff; box-shadow:0 8px 24px rgba(30,27,24,.18); text-decoration:none; font-weight:700; } :focus-visible { outline:3px solid var(--ultramarine); outline-offset:4px; }
  @media (max-width:700px) { .shell { width:min(100% - 32px, 560px); } .header-inner { min-height:76px; } .brand { width:135px; } .menu-toggle { display:inline-flex; } .site-nav { display:none; position:absolute; top:76px; left:0; right:0; z-index:2; padding:1rem; border-bottom:1px solid var(--line); background:var(--ivory); box-shadow:0 12px 24px rgba(30,27,24,.08); } .site-nav.is-open { display:block; } .site-nav ul { flex-direction:column; } .site-nav a { justify-content:flex-start; width:100%; } .page { padding:4rem 0 7rem; } h1 { font-size:clamp(2.8rem, 15vw, 5rem); } .footer-grid { flex-direction:column; } .support-cta { right:1rem; bottom:1rem; } }
</style>
