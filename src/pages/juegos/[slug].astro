---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameDetail from '../../components/GameDetail.astro';
import { games } from '../../data/games.js';
export function getStaticPaths() { return games.map((game) => ({ params: { slug: game.slug }, props: { game } })); }
const { game } = Astro.props;
---
<BaseLayout title={game.name} description={`${game.title} ${game.summary}`}><section class="page"><div class="shell"><GameDetail game={game} /></div></section></BaseLayout>
