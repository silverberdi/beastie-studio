---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCarousel from '../components/GameCarousel.astro';
import ParallaxHero from '../components/ParallaxHero.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { games } from '../data/games.js';
const articles = (await getCollection('news')).slice(0, 3);
---
<BaseLayout title="Inicio" description="Descubre los juegos de Beastie Studio: aprender, pensar y compartir juegos hechos con cariño.">
  <ParallaxHero image="/assets/v5/hero-parque-beastie.webp" imageAlt="Parque de Beastie Studio al atardecer." eyebrow="Estudio independiente de videojuegos" title="Descubrir. Pensar. Compartir." titleLines={["Descubrir.", "Pensar.", "Compartir."]} description="Creamos juegos para despertar la curiosidad, disfrutar nuevos retos y compartir buenos momentos." ctaHref="/juegos" ctaLabel="Explorar juegos" />
  <section class="section section-tint" id="catalogo" data-reveal><div class="shell"><div class="section-heading"><p class="eyebrow">Catálogo oficial</p><h2>Dos experiencias para pensar, sonreír y compartir.</h2><p>Diseñamos juegos directos y profundos, fáciles de empezar y llenos de matices para descubrir a tu propio ritmo.</p></div><GameCarousel games={games} /></div></section>
  <section class="section" data-reveal><div class="shell"><div class="section-heading"><p class="eyebrow">Cuaderno de bitácora</p><h2>Novedades del estudio</h2><p>Historias, ideas y avances detrás de nuestros juegos.</p></div><div class="card-grid news-home-grid">{articles.map((article) => <NewsCard article={article} />)}</div><a class="button button-secondary" href="/novedades">Explorar todas las novedades →</a></div></section>
  <section class="section section-warm" data-reveal><div class="shell"><div class="section-heading"><p class="eyebrow">Manifiesto Beastie</p><h2>Creemos en la curiosidad como motor y en el juego como un lenguaje universal.</h2><p>Queremos hacer experiencias accesibles, cuidadas y fáciles de descubrir, respetando el tiempo y la atención de cada familia.</p></div><div class="principles"><article class="principle-card"><h3>Claridad</h3><p>Instrucciones transparentes y experiencias sencillas de entender.</p></article><article class="principle-card"><h3>Curiosidad</h3><p>Espacios para pensar, explorar y descubrir nuevas preguntas.</p></article><article class="principle-card"><h3>Compartir</h3><p>Momentos para jugar y conversar con otras personas.</p></article></div></div></section>
  <section class="section" data-reveal><div class="shell"><div class="support-sharing"><p class="eyebrow">Comunidad y sostenibilidad</p><h2>Ayúdanos a seguir creando juegos libres y gratuitos.</h2><p>Si valoras nuestro trabajo, puedes apoyar el proyecto o compartirlo con otras personas.</p><a class="button button-primary" href="/apoyanos">Conoce las formas de apoyar →</a></div></div></section>
</BaseLayout>
