---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('news');
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const related = (await getCollection('news'))
  .filter((candidate) => candidate.data.category === data.category && candidate.id !== article.id)
  .slice(0, 2);
---

<BaseLayout title={data.title} description={data.summary} activePath="/novedades" type="article" image={data.heroImage} imageAlt={`Ilustración editorial de ${data.title}`} breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Novedades', url: '/novedades' }, { name: data.title }]} entity={{ '@type': 'BlogPosting', headline: data.title, description: data.summary, url: Astro.site ? new URL(`/novedades/${data.slug}`, Astro.site).href : undefined, image: data.heroImage && Astro.site ? new URL(data.heroImage, Astro.site).href : undefined, datePublished: data.publishedAt?.toISOString() }}>
  <article class="page article-page">
    <div class="shell article-shell">
      <nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/novedades">Novedades</a><span aria-hidden="true">/</span><span aria-current="page">{data.title}</span></nav>
      <header class="article-header">
        <p class="eyebrow">{data.category}</p>
        <h1>{data.title}</h1>
        <p class="lead">{data.summary}</p>
      </header>
      {data.publishedAt && <time datetime={data.publishedAt.toISOString()}>{data.publishedAt.toLocaleDateString('es-CO')}</time>}
      {data.heroImage && <img class="article-hero" src={data.heroImage} alt={`Ilustración editorial de ${data.title}`} width="1200" height="675" fetchpriority="high" decoding="async" />}
      <div class="article-body"><Content /></div>
      <div class="article-actions"><a class="button button-secondary" href="/novedades">← Volver a novedades</a><a class="button button-primary" href="/juegos">Explorar juegos <span aria-hidden="true">→</span></a></div>
      {related.length > 0 && <section class="related" aria-labelledby="related-title"><p class="eyebrow">Para seguir leyendo</p><h2 id="related-title">Más historias de {data.category}</h2><div class="card-grid">{related.map((candidate) => <NewsCard article={candidate} />)}</div></section>}
    </div>
  </article>
</BaseLayout>
