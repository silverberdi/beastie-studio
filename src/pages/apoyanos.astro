---
import BaseLayout from '../layouts/BaseLayout.astro';
import SupportChannel from '../components/SupportChannel.astro';
import { visibleSupportChannels } from '../data/support.js';
---
<BaseLayout title="Apóyanos" description="Formas voluntarias de apoyar a Beastie Studio y compartir sus juegos.">
  <section class="page support-page"><div class="shell">
    <div class="support-intro"><div><p class="eyebrow">Comunidad y sostenibilidad independiente</p><h1>Ayúdanos a seguir creando.</h1><p class="lead">Nuestros juegos nacen de la curiosidad y crecen gracias a quienes creen en ellos. Si valoras el proyecto, aquí encontrarás distintas formas de hacerlo. Tu aporte es completamente voluntario.</p><div class="pills"><span class="pill">✓ 100% voluntario</span><span class="pill">✓ Sin suscripciones forzadas</span><span class="pill">✓ Transparencia total</span></div></div><img class="support-illustration" src="/assets/illustrations/illustration-apoyanos.png" alt="Ilustración conceptual sobre apoyar a Beastie Studio; no es una captura de un juego." width="200" height="200" /></div>
    <section class="support-options" aria-labelledby="support-options-title"><div class="section-heading"><p class="eyebrow">Opciones de apoyo</p><h2 id="support-options-title">Elige la forma que te resulte más cómoda.</h2><p>Los canales se activarán únicamente cuando exista un enlace, destinatario o recurso aprobado.</p></div><div class="support-grid">{visibleSupportChannels().map((channel) => <SupportChannel channel={channel} />)}</div></section>
    <section class="support-sharing" aria-labelledby="sharing-title"><p class="eyebrow">Otra forma de ayudar</p><h2 id="sharing-title">También puedes ayudar compartiendo.</h2><p>Recomendar nuestros juegos a alguien interesado también nos ayuda a llegar a nuevas personas.</p><div class="button-row"><a class="button button-secondary" href="/juegos/multiplo">Conocer Múltiplo <span aria-hidden="true">→</span></a><a class="button button-secondary" href="/juegos/boxio">Conocer Boxio <span aria-hidden="true">→</span></a></div></section>
    <p class="support-thanks">Gracias por acompañar juegos hechos con cariño.</p>
  </div></section>
</BaseLayout>
