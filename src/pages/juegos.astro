---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import ParallaxHero from '../components/ParallaxHero.astro';
import { games } from '../data/games.js';
---
<BaseLayout title="Juegos" description="Conoce Múltiplo y Boxio, los juegos de Beastie Studio."><ParallaxHero image="/assets/v5/hero-juegos-islass.webp" imageAlt="Paisaje ilustrado del catálogo de juegos." eyebrow="Catálogo de juegos" title="Nuestros juegos." titleLines={["Nuestros", "juegos."]} description="Algunos nos invitan a aprender; otros, a pensar una jugada más o compartir una partida. Todos están hechos con cariño." ctaHref="#catalogo" ctaLabel="Ver catálogo" /><section class="section" id="catalogo" data-reveal><div class="shell"><div class="portfolio-list">{games.map((game, index) => <GameCard game={game} index={index} />)}</div></div></section></BaseLayout>
