---
const { game } = Astro.props;
---
<article class="game-detail">
  <div>
    <figure class="game-detail-visual screenshot-frame"><img src={game.primaryScreenshot} alt={game.primaryScreenshotAlt} width={game.primaryScreenshotWidth} height={game.primaryScreenshotHeight} srcset={`${game.primaryScreenshot} ${game.primaryScreenshotWidth}w`} sizes="(max-width: 700px) 100vw, 45vw" fetchpriority="high" decoding="async" /></figure>
    {game.gallery?.length && <div class="game-gallery" aria-label={`Galería de ${game.name}`}>
      {game.gallery.map((image) => <figure class="gallery-item"><img src={image.src} alt={image.alt} width={image.width} height={image.height} srcset={`${image.src} ${image.width}w`} sizes="(max-width: 700px) 33vw, 160px" loading="lazy" decoding="async" /></figure>)}
    </div>}
  </div>
  <div class="game-detail-copy">
    <p class="eyebrow">{game.name}</p><h1>{game.title}</h1><p class="lead">{game.summary}</p><p>{game.story}</p>
    <div class="button-row"><a class="button button-secondary" href="/juegos">Conocer los juegos <span aria-hidden="true">→</span></a>{game.publicUrl && <a class="button button-primary" href={game.publicUrl} target="_blank" rel="noopener noreferrer">Jugar {game.name} <span aria-hidden="true">↗</span></a>}</div>
    {!game.publicUrl && <p class="not-available" role="status">La URL pública de {game.name} todavía no está verificada. «Jugar» estará disponible cuando exista un destino confirmado.</p>}
  </div>
</article>
