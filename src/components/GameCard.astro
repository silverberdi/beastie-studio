---
const { game } = Astro.props;
---
<article class="game-card">
  <div class="conceptual-art" role="img" aria-label={game.illustrationAlt}><img src={game.illustration} alt={game.illustrationAlt} width="200" height="200" /></div>
  <div class="game-card-body">
    <p class="eyebrow">{game.name}</p>
    <h2>{game.title}</h2>
    <p>{game.summary}</p>
    <div class="button-row">
      {game.publicUrl && <a class="button button-primary" href={game.publicUrl}>Jugar {game.name} <span aria-hidden="true">↗</span></a>}
      <a class="button button-secondary" href={`/juegos/${game.slug}`}>Conocer {game.name} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
