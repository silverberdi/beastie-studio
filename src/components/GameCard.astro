---
const { game, index = 0, variant = 'catalog' } = Astro.props;
const displayImage = variant === 'home'
  ? (game.homeImage ?? game.composition ?? game.primaryScreenshot)
  : (game.catalogImage ?? game.composition ?? game.primaryScreenshot);
const displayAlt = variant === 'home'
  ? (game.homeImageAlt ?? game.compositionAlt ?? game.primaryScreenshotAlt)
  : (game.catalogImageAlt ?? game.compositionAlt ?? game.primaryScreenshotAlt);
---
<article class:list={["game-card", "portfolio-project", "composition-card", { "portfolio-project-reverse": index % 2 === 1, [`composition-${game.compositionOrientation}`]: game.compositionOrientation }]} data-game={game.slug}>
  <div class="game-card-visual screenshot-frame"><img src={displayImage} alt={displayAlt} width="1600" height="900" srcset={`${displayImage} 1600w, ${game.composition} 1600w`} sizes="(max-width: 700px) 100vw, 50vw" loading="eager" decoding="async" /></div>
  <div class="game-card-body">
    <p class="eyebrow">{game.name}</p>
    <h2>{game.title}</h2>
    <p>{game.summary}</p>
    <div class="button-row">
      {game.publicUrl && <a class="button button-primary" href={game.publicUrl} target="_blank" rel="noopener noreferrer">Jugar {game.name} <span aria-hidden="true">↗</span></a>}
      <a class="button button-secondary" href={`/juegos/${game.slug}`}>Conocer {game.name} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
