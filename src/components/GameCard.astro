---
const { game, index = 0 } = Astro.props;
---
<article class:list={["game-card", "portfolio-project", "composition-card", { "portfolio-project-reverse": index % 2 === 1, [`composition-${game.compositionOrientation}`]: game.compositionOrientation }]} data-game={game.slug}>
  <div class="game-card-visual screenshot-frame"><img src={game.composition ?? game.primaryScreenshot} alt={game.compositionAlt ?? game.primaryScreenshotAlt} width={game.compositionWidth ?? game.primaryScreenshotWidth} height={game.compositionHeight ?? game.primaryScreenshotHeight} srcset={`${game.composition ?? game.primaryScreenshot} ${game.compositionWidth ?? game.primaryScreenshotWidth}w`} sizes="(max-width: 700px) 100vw, 50vw" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
  <div class="game-card-body">
    <p class="eyebrow">{game.name}</p>
    <h2>{game.title}</h2>
    <p>{game.summary}</p>
    <div class="button-row">
      {game.publicUrl && <a class="button button-primary" href={game.publicUrl} target="_blank" rel="noopener noreferrer">Jugar {game.name} <span aria-hidden="true">↗</span></a>}
      <a class="button button-secondary" href={`/juegos/${game.slug}`}>Conocer {game.name} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
