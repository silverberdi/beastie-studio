---
import GameCard from './GameCard.astro';
const { games } = Astro.props;
---
<div class="game-carousel" data-game-carousel aria-label="Juegos destacados">
  <div class="game-carousel-track">
    {games.map((game, index) => <div class="game-slide" data-slide={index} aria-hidden={index !== 0}><GameCard game={game} /></div>)}
  </div>
  <div class="carousel-controls">
    <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Juego anterior">←</button>
    <div class="carousel-dots" role="tablist" aria-label="Seleccionar juego">
      {games.map((game, index) => <button class="carousel-dot" type="button" role="tab" data-carousel-dot={index} aria-label={`Ver ${game.name}`} aria-selected={index === 0}></button>)}
    </div>
    <button class="carousel-arrow" type="button" data-carousel-next aria-label="Siguiente juego">→</button>
  </div>
</div>
<script>
  const root = document.querySelector('[data-game-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll('[data-slide]')];
    const dots = [...root.querySelectorAll('[data-carousel-dot]')];
    let active = 0;
    const render = (next) => {
      active = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => { slide.hidden = index !== active; slide.setAttribute('aria-hidden', String(index !== active)); });
      dots.forEach((dot, index) => { dot.setAttribute('aria-selected', String(index === active)); dot.classList.toggle('is-active', index === active); });
    };
    root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => render(active - 1));
    root.querySelector('[data-carousel-next]')?.addEventListener('click', () => render(active + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => render(index)));
    root.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') render(active - 1); if (event.key === 'ArrowRight') render(active + 1); });
    let startX = 0;
    root.addEventListener('touchstart', (event) => { startX = event.changedTouches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (event) => { const delta = event.changedTouches[0].clientX - startX; if (Math.abs(delta) > 40) render(active + (delta < 0 ? 1 : -1)); }, { passive: true });
    render(0);
  }
</script>
